# ========================================
# Eduplatform Frontend - Environment Variables
# ========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to Git!

# ========================================
# API Configuration (REQUIRED)
# ========================================

# Backend API URL
# Local development
VITE_API_BASE=http://localhost:8000

# Production (change to your deployed backend URL)
# VITE_API_BASE=https://api.your-domain.com

# ========================================
# WebSocket Configuration
# ========================================

# WebSocket URL for real-time features
VITE_WS_URL=ws://localhost:8000

# Production WebSocket URL
# VITE_WS_URL=wss://api.your-domain.com

# ========================================
# Vite Dev Server Proxy (Optional)
# ========================================
# Override the dev-server proxy targets if your backend runs somewhere other
# than localhost:8000. Defaults preserve the previous hardcoded behaviour.
VITE_PROXY_TARGET=http://localhost:8000
VITE_PROXY_WS_TARGET=ws://localhost:8000

# ========================================
# Application Environment
# ========================================

# App environment: development | staging | production
VITE_APP_ENV=development

# Public host for CORS (optional)
# VITE_PUBLIC_HOST=https://your-frontend-url.vercel.app

# ========================================
# Feature Flags (Optional)
# ========================================

# Enable AI features
VITE_ENABLE_AI=true

# Enable AR features
VITE_ENABLE_AR=true

# ========================================
# Sentry (Optional)
# ========================================
# Public DSN from sentry.io → Project Settings → Client Keys (DSN)
# Safe to expose in client bundle (it identifies the project, not auth)
# Leave empty to disable Sentry initialization
# VITE_SENTRY_DSN=https://xxxxx@xxx.ingest.sentry.io/xxxxx

# ========================================
# Deployment Notes
# ========================================
# For Vercel:
#   1. Add these environment variables in Vercel dashboard
#   2. Or use vercel env add command
#
# For Docker:
#   1. Copy to .env in frontend-web directory
#   2. Rebuild with: docker-compose build frontend
