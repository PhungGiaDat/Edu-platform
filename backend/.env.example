# ========================================
# Eduplatform Backend - Environment Variables
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to Git!

# ========================================
# MongoDB Configuration (REQUIRED)
# ========================================
# Local development
MONGO_URL=mongodb://localhost:27017

# Production (Atlas example)
# MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

MONGO_DB=edu_platform

# ========================================
# Security (REQUIRED for Production)
# ========================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========================================
# Application Settings
# ========================================
APP_NAME=Eduplatform AR API

# Set to true for development, false for production
DEBUG=false

API_V1_PREFIX=/api/v1

# ========================================
# CORS Settings
# ========================================
# Use "*" for development, specific domains for production
# Multiple domains: https://example.com,https://app.example.com
ALLOWED_ORIGINS=*

# ========================================
# Server Settings
# ========================================
HOST=0.0.0.0
PORT=8000
WORKERS=2

# ========================================
# AI Services (Optional)
# ========================================
# Google Gemini API for AI content generation
GOOGLE_API_KEY=

# OpenAI API (if needed)
OPENAI_API_KEY=

# ========================================
# Supabase (Optional - for file storage)
# ========================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ========================================
# Redis Configuration (Caching & Sessions)
# ========================================
# Local development
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Alternative: Full Redis URL (takes precedence over individual settings)
# Format: redis://localhost:6379/0 or rediss://user:pass@host:port/0
REDIS_URL=

# Connection pool settings
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# SSL/TLS (set to true for production with cloud Redis)
REDIS_SSL=false

# ========================================
# App Lock / Time Limit Settings
# ========================================
# Default TTL in minutes for app lock (auto-lock after inactivity)
APP_LOCK_DEFAULT_TTL_MINUTES=30
# Warning threshold in minutes (notify user before lock)
APP_LOCK_WARNING_TTL_MINUTES=25
# Maximum lock extension in minutes (parent override)
APP_LOCK_MAX_EXTENSION_MINUTES=60

# ========================================
# Rate Limiting Settings
# ========================================
# Auth endpoints (login, register) - per IP
RATE_LIMIT_AUTH_PER_MINUTE=10
# General API endpoints - per user
RATE_LIMIT_API_PER_MINUTE=60
# Strict limit per hour
RATE_LIMIT_API_PER_HOUR=1000
# Burst allowance
RATE_LIMIT_BURST=10

# ========================================
# Session Settings
# ========================================
# Session TTL in hours
SESSION_TTL_HOURS=24
# Session refresh threshold - refresh before expiry (minutes)
SESSION_REFRESH_THRESHOLD_MINUTES=30

# ========================================
# Cache Settings
# ========================================
# Default TTL for cached data in seconds
REDIS_TTL=300
# Pet catalog cache TTL (seconds)
CACHE_PETS_TTL_SECONDS=600
# Course data cache TTL (seconds)
CACHE_COURSE_TTL_SECONDS=300
# User stats cache TTL (seconds)
CACHE_USER_STATS_TTL_SECONDS=60
# Leaderboard cache TTL (seconds)
CACHE_LEADERBOARD_TTL_SECONDS=300

# ========================================
# Supabase Redis Backup (Optional)
# ========================================
# Backup session data to Supabase for long-term storage
SUPABASE_REDIS_BACKUP_ENABLED=false

# ========================================
# Deployment Notes
# ========================================
# For Docker Compose: Copy to .env and run `docker-compose up -d`
# For Render.com:
#   1. Set MONGO_URL in Render dashboard (Environment tab)
#   2. SECRET_KEY can be auto-generated in Render
#   3. Update ALLOWED_ORIGINS with your frontend domain
#
# For Railway:
#   1. Add MONGO_URL environment variable
#   2. Add SECRET_KEY environment variable
#   3. Set start command: gunicorn main:app --bind 0.0.0.0:$PORT --worker-class uvicorn.workers.UvicornWorker
