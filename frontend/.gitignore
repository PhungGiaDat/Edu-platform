# env files

.env

# MindAR compiled catalogs (large binaries — served via Supabase Storage CDN,
# not bundled with the frontend deployment).  The matching ``.manifest.json``
# and ``.sources.json`` files ARE tracked because they document the catalog
# contract (catalogId, sha256, target list).  Re-compile with
# ``node frontend/scripts/buildMindCatalog.mjs`` and upload the ``.mind``
# binary to ``AR_models/mind-catalogs/<catalog-id>/<sha256>.mind`` on
# Supabase Storage.  See docs/plan/20260802_hardcoded_values_refactor.md for
# the rationale.
*.mind
public/assets/target/catalogs/*.mind

# Legacy in-repo targets are still trackable: `src/utils/mindTargetMerge.test.ts`
# reads them directly to verify the merge contract, and they are already
# tracked on main (frontend-web/public/assets/target/*.mind). Only the
# compiled per-catalog binaries under catalogs/ stay CDN-only.
!public/assets/target/combo_targets.mind
!public/assets/target/elephant_targets.mind
!public/assets/target/jungle_targets.mind

