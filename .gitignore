## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# OpenCode workspace config IS version-controlled (agents, commands, plugins,
# rules, package manifest).
#
# skills/ is deliberately NOT tracked. It is a vendored mirror: 122 of 132 dirs
# are byte-identical copies of .cursor/skills, 10 more have silently drifted,
# and the remaining unity-* skills are already tracked under .claude/skills and
# .agents/skills. OpenCode V2 discovers skills from those compatibility sources
# too (verified: it loads .claude/skills, .agents/skills and .opencode/skills),
# so nothing is lost by ignoring this copy.
.opencode/skills
.opencode/node_modules

# Each vendored superpowers copy ships its own (V1-only) .opencode/ plugin dir.
# The previous blanket ".opencode" pattern matched at every depth and hid these;
# now that the root config is tracked they surface as untracked noise, so ignore
# them explicitly to stop a stray "git add -A" from committing the dead V1
# plugin three more times.
.claude/skills/*/.opencode/
.agents/skills/*/.opencode/
.cursor/skills/*/.opencode/

# Local agent permissions and MCP credentials
.claude/settings.local.json

# Scripts (root level)
!/scripts/
scripts/*.py
scripts/*.js
scripts/*.sh
scripts/*.md
!scripts/compile_xr_targets.js
!scripts/upload_ragdoll_3d.py
!scripts/upload_tus_ragdoll.py
!scripts/README_3D_UPLOAD.md
!backend/scripts/
backend/scripts/*
!backend/scripts/create_admin.py
!backend/scripts/repair_momo_course_unicode.py
# Re-include Unity's Scripts folders (case-insensitive). The bare "scripts" pattern
# above would otherwise match any directory named "Scripts" anywhere in the tree,
# including Unity's Assets/Scripts/. Unity requires these C# scripts to be tracked.
!mobile/unity/Assets/Scripts/
.git
backend/generated/

.docs

.shared/
