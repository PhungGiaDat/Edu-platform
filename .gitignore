PublishScripts/

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Re-include Unity's Packages/ folder (manifest.json, packages-lock.json).
# The pattern above would otherwise catch Unity's Package Manager folder,
# which is required to be committed so the Unity project resolves correctly
# on Codemagic's Mac builder.
!mobile/unity/Packages/
!mobile/unity/Packages/**
# Uncomment if necessary however generally it will be regenerated when needed
#!**/[Pp]ackages/repositories.config
# NuGet v3's project.json files produces more ignorable files
*.nuget.props
*.nuget.targets

# Microsoft Azure Build Output
csx/
*.build.csdef

